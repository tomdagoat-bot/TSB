const function Gerp_Table(t)
	const Values = table.clone(t)
	table.clear(t)
	for Key, Value in Values do
		if typeof(Value) == "table" then
			Gerp_Table(Value)
			t[Key] = Value
		else
			t[Value] = true
		end
	end
	return Values
end

