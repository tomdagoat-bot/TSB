const function Target(Guy)
	const Model = Guy or getgenv().Target
	if not Model then return end
	const H = Model:WaitForChild("Humanoid",Yield_TimeOut)
	const HRP = Model:WaitForChild("HumanoidRootPart",Yield_TimeOut)
	const P = Players:GetPlayerFromCharacter(Model)
	const A = H:WaitForChild("Animator",Yield_TimeOut)
	return Model,H,HRP,P,A
end

const function AddAccessory(Accessory)
	if not Accessory:IsA("Accessory") then
		return
	end

	const Cloned = Accessory:Clone()
	const Handle = Cloned:FindFirstChild("Handle")

	if not Handle or not Handle:IsA("BasePart") then
		Cloned:Destroy()
		return
	end

	Handle.CanCollide = false
	Handle.Massless = true

	const Acc_Attach = Handle:FindFirstChildOfClass("Attachment")

	if not Acc_Attach then
		Cloned:Destroy()
		return
	end

	const Char_Attach = Character:FindFirstChild(Acc_Attach.Name,true)

	if not Char_Attach then
		Cloned:Destroy()
		return
	end

	Cloned.Parent = Character

	Handle.CFrame = Char_Attach.WorldCFrame * Acc_Attach.CFrame:Inverse()

	const Weld = Instance.new("Weld")
	Weld.Name = "AccessoryWeld"
	Weld.Part0 = Char_Attach.Parent
	Weld.Part1 = Handle
	Weld.C0 = Char_Attach.CFrame
	Weld.C1 = Acc_Attach.CFrame
	Weld.Parent = Handle

	return Cloned
end

