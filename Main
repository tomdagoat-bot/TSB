const Emotes = PlayerGui.Emotes:FindFirstChildOfClass("ImageLabel")

const Positioning = {
	[5] = UDim2.fromScale(.8,.23),
	[6] = UDim2.fromScale(.2,.23),
	[7] = UDim2.fromScale(.2,.83),
	[8] = UDim2.fromScale(.8,.83),
}

for i = 5, 8 do
	const Emote = Emotes:FindFirstChild(tostring(i))
	if not Emote then continue end

	Emote.Visible = true

	Emote:FindFirstChildOfClass("UIAspectRatioConstraint").AspectRatio = 1
	Emote.Position = Positioning[i]

	Emote:FindFirstChildOfClass("TextButton").Visible = true
end

for _, Emote in Emotes:GetChildren() do
	if not tonumber(Emote.Name) then continue end

	Emote.Radial.Visible = false
	Emote.Radial:GetPropertyChangedSignal("Visible"):Connect(function()
		if not Emote.Radial.Visible then return end

		Emote.Radial.Visible = false
	end)

	Emote.Button.MouseButton1Click:Connect(function()
		if Emote.Radial:FindFirstChildOfClass("ImageLabel") then
			Communicate({Goal = "Emote",Emote = Emote.EmoteName.Text})
		end
	end)
end

for Moveset, Name in Moveset_Rename do
	if Moveset == "CUSTOM" then continue end
	if not Is_PS and Illegal_Movesets[Moveset] then continue end

	Characters_Tab:CreateSection({["Name"] = `{Name} Moveset`,["Description"] = "Made To Use It In Duels"}):AddButton({["Name"] = "Switch To",["CallBack"] = function()
		Communicate({Goal = "Change Character",Character = Moveset})
	end})
end

namecall = hookmetamethod(game,"__namecall",function(self,...)
	const args = {...}
	const method = getnamecallmethod():lower()

	if not checkcaller() and self == RE and method == "fireserver" then
		const Info = args[1]
		if Info.Goal == "delete bv" and getgenv().InTech and Override_StopDash then
			return
		elseif Info.Goal == "Console Move" and Info.ToolName == "Crushing Pull" and getgenv().Target then
			Info.CrushingPull = getgenv().Target
		end
		return namecall(self,Info)
	end

	return namecall(self,...)
end)

Events:Init()

