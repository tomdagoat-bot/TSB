const function Locked_Ult(TargetPlayer)
	local ult = TargetPlayer:GetAttribute("Ultimate") or 0
	ult = MathService.Alpha(ult,100)

	if Locked_Ultimate_Tween then
		Locked_Ultimate_Tween:Cancel()
	end

	Locked_Ultimate_Tween = TweenService:Create(TargetBars.Ultimate.Fill,Bar,{Size = UDim2.fromScale(ult, 1)})

	Locked_Ultimate_Tween:Play()

	TargetBars.Ultimate.Value.Text = `Ultimate: {tostring(math.round(ult * 100))}%`
end

const function Locked_HP(TargetHum,Target)
	const hp = MathService.Alpha(TargetHum.Health,TargetHum.MaxHealth)

	if Locked_HP_Tween then
		Locked_HP_Tween:Cancel()
	end

	Locked_HP_Tween = TweenService:Create(TargetBars.Health.Fill,Bar,{Size = UDim2.fromScale(hp, 1)})

	Locked_HP_Tween:Play()

	TargetBars.Health.Value.Text = `Heath: {tostring(math.round(hp * 100))}%`

	if hp <= 0 then
		Set_Target(nil,Target.Name)
	end
end

const function Locked_UsedUlt(Target,bool)
	TargetBars.Ultimate.Value.Text = bool and "IN ULTIMATE" or "Ultimate: 0%"
	TweenService:Create(TargetBars.Ultimate.Fill,Bar,{Size = UDim2.fromScale(bool and 1 or 0,1)}):Play()
end

function Update_TargetInfo()
	const Target : Model,Target_Hum : Humanoid,Target_Hrp,Target_Plr : Player,_ = Target()

	TargetUI.Username.Text = Target_Plr and Target_Plr.DisplayName or Target.Name
	TargetUI.Username.Profile:FindFirstChildOfClass("ImageLabel").Image = GetProfile(Target_Plr)

	const Player_Exists = Target_Plr ~= nil

	TargetBars.Ultimate.Visible = Player_Exists
	TargetBars.Ragdoll.Visible = Player_Exists
	TargetUI.Moveset.Visible = Player_Exists
	TargetUI.Kills.Visible = Player_Exists
	TargetUI["Total Kills"].Visible = Player_Exists
	TargetUI.Streak.Visible = Player_Exists

	if Player_Exists then

		Locked_Evasive(Target)

		ConnectionService.Connect("Evasive",Target_Key,Target:GetAttributeChangedSignal("JustEvasived"),nil,"Connect",function()
			Locked_Evasive(Target)
		end)

		Locked_Kills(Target_Plr)

		ConnectionService.Connect("KillsAdded",Target_Key,Target_Plr:WaitForChild("leaderstats").ChildAdded,nil,"Connect",function(DataStored)
			if DataStored.Name == "Kills" then
				Locked_Kills(Target_Plr)
			end
		end)

		ConnectionService.Connect("KillsRemoved",Target_Key,Target_Plr:WaitForChild("leaderstats").ChildRemoved,nil,"Connect",function(DataStored)
			if DataStored.Name == "Kills" then
				Locked_Kills(Target_Plr)
			end
		end)

		Locked_DC(Target)

		ConnectionService.Connect("DeathCountered",Target_Key,Target:GetAttributeChangedSignal("DeathCounter"),nil,"Connect",function()
			Locked_DC(Target)
		end)

		Locked_TK(Target_Plr)

		ConnectionService.Connect("Total Kills",Target_Key,Target_Plr:GetAttributeChangedSignal("TotalKillsFrb"),nil,"Connect",function()
			Locked_TK(Target_Plr)
		end)

		Locked_Streak(Target)

		ConnectionService.Connect("Streak",Target_Key,Target:GetAttributeChangedSignal("CurrentStreak"),nil,"Connect",function()
			Locked_Streak(Target)
		end)

		Locked_Ult(Target_Plr)

		ConnectionService.Connect("Ultimate",Target_Key,Target_Plr:GetAttributeChangedSignal("Ultimate"),nil,"Connect",function()
			Locked_Ult(Target_Plr)
		end)

		if Target:GetAttribute("Ulted") then
			Locked_UsedUlt(Target,true)
		end

		ConnectionService.Connect("UltimateIn",Target_Key,Target:GetAttributeChangedSignal("Ulted"),nil,"Connect",function()
			Locked_UsedUlt(Target,Target:GetAttribute("Ulted"))
		end)

		local Moveset = Target:GetAttribute("Character") or "CUSTOM"

		TargetUI.Moveset.Text = `Moveset: {Moveset_Rename[Moveset] or Target:GetAttribute("Character")}`

		ConnectionService.Connect("Moveset",Target_Key,Target:GetAttributeChangedSignal("Character"),nil,"Connect",function()
			Moveset = Target:GetAttribute("Character") or "CUSTOM"
			TargetUI.Moveset.Text = `Moveset: {Moveset_Rename[Moveset] or Target:GetAttribute("Character")}`
		end)
	end

	Locked_HP(Target_Hum,Target)

	ConnectionService.Connect("Health",Target_Key,Target_Hum.HealthChanged,nil,"Connect",function()
		Locked_HP(Target_Hum,Target)
	end)

	ConnectionService.Connect("Died",Target_Key,Target_Hum.Died,nil,"Connect",function()
		ConnectionService.Disconnect(nil,Target_Key)
	end)

	ConnectionService.Connect("Teleportation",Target_Key,Teleporter.MouseButton1Click,nil,"Connect",function()
		Hrp.CFrame = Target_Hrp.CFrame * CFrame.new(0,0,Attack_Distance - 4)
	end)

end

const Is_Mobile = UserInputService.TouchEnabled

const function Get_Nearest(Origin,Dead)
	return MathService.Nearest(Origin ~= nil and Origin or Is_Mobile and Hrp or Mouse.Hit,Dead)
end

const SilentAim_Section = SilentAim_Tab:CreateSection()

const SilentAim_Button = SilentAim_Section:AddToggle({
	Name = "Silent Aim",
	CallBack = function(_)
		SilentAim()
	end,
	Icon = "rbxassetid://139650104834071"
})

SilentAim_Button:BindInput("T")

function SilentAim(Object)
	if SilentAim_Button.Enabled then
		DelayService.Yield(function() return Env.Target ~= nil end,60)
		Stare_Connection(Object) 
	else
		Stare_Stop()
	end
end

Player:SetAttribute("S_CDINDICATOR", true)

Player:GetAttributeChangedSignal("S_CDINDICATOR"):Connect(function()
	if Player:GetAttribute("S_CDINDICATOR") then return end

	Player:SetAttribute("S_CDINDICATOR", true)
end)

function Communicate(Args)
	if not RE then return end
	RE:FireServer(Args)
end

const function FrontDash()
	Communicate({Dash = Enum.KeyCode.W, Key = Enum.KeyCode.Q, Goal = "KeyPress"})
end

const function BackDash()
	Communicate({Dash = Enum.KeyCode.S, Key = Enum.KeyCode.Q, Goal = "KeyPress"})
end

const function SideDash(Direction)
	Communicate({Dash = Enum.KeyCode[Direction], Key = Enum.KeyCode.Q, Goal = "KeyPress"})
end

const function Unblock()
	Communicate({Key = Enum.KeyCode.F, Goal = "KeyRelease"})
end

const function Block(duration)
	Communicate({Key = Enum.KeyCode.F, Goal = "KeyPress"})
	DelayService.Delay("Blocking",duration or .2,function()
		Unblock()		
	end)
end

const function StopM1()
	Communicate({Goal = "LeftClickRelease"})
end

const function M1(duration)
	Communicate({Goal = "LeftClick"})
	DelayService.Delay("M1ing",duration or .2,function()
		StopM1()		
	end)
end

const function WallCombo()
	Communicate({Goal = "Wall Combo"})
end

const function UseMove(Move)
	const Object = Player:FindFirstChild("Backpack"):FindFirstChild(Move)
	if not Object then return end

	Communicate({IsAutoActivate = true, Goal = "Console Move", Tool = Object, ToolName = Move})
end

const function StopDash()
	Communicate({BV = Hrp:FindFirstChild("moveme"), Goal = "delete bv"})
end

const CounterUI = Storage:FindFirstChild("Counters")
const TechDisplay = Storage:FindFirstChild("TechFx")

const TechTween = TweenInfo.new(.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)

function Tech_FX(Tech)
	const TechUI = Character:FindFirstChild("TechFx")
	if TechUI then
		TechUI.Tech.Text = Tech

		TweenService:Create(TechUI,TechTween,{Size = TechUI:GetAttribute("Size")}):Play()

		HighlightService.new(Env.Picked_Skin or "Tech",Character,1)

		DelayService.Delay(`{Tech}-TechFx`,1,function()
			TweenService:Create(TechUI,TechTween,{Size = UDim2.fromScale(0, 0)}):Play()
		end)
	end
end

function Look_Behind(Root,Duration)
	if Hrp == Root then
		return
	end
	const Person = Root.Parent
	ConnectionService.Connect("Near",Person,RunService.Heartbeat,Duration,"Connect",function()
		if MathService.GetDistance(Hrp,Root) <= Safe_Distance and not Character:FindFirstChild("Ragdoll") then
			Stare_Stop()
			MathService.LookAt(Hrp, Hrp.Position * 2 - Root.Position)
			Person.Humanoid.AutoRotate = false
		else
			SilentAim()
			Person.Humanoid.AutoRotate = true
		end
	end)

	DelayService.Delay(`{Root.Parent.Name}-Countered_Stare`,Duration + .2,function()
		SilentAim()
	end)
end

Events.Bind("Counter",function(Person,Root,UI)
	if Person:HasTag("Counter-Cooldown") then return end
	Person:AddTag("Counter-Cooldown")

	const Distance = MathService.GetDistance(Hrp,Root)

	if Distance <= Safe_Distance then
		PlaySound("Counter")
		if Distance <= Safe_Distance / 2 then
			Communicate({Dash = Enum.KeyCode.S, Key = Enum.KeyCode.Q, Goal = "KeyPress"})
			Hrp.AssemblyLinearVelocity = -Root.CFrame.LookVector * 90
		end
	end

	HighlightService.new("Counter",Person,Counter_Duration)

	if UI then
		UI.Counter.Visible = true

		DelayService.Delay(`{Person.Name}-Counter`,Counter_Duration,function()
			UI.Counter.Visible = false
			Person:RemoveTag("Counter-Cooldown")
		end)
	end

	Look_Behind(Root,Counter_Duration)
end)

Events.Bind("Death Counter",function(Person,Root,CounterDisplay)
	if Person:HasTag("Counter-Cooldown") then return end
	Person:AddTag("Counter-Cooldown")

	if MathService.GetDistance(Hrp,Root) <= Safe_Distance then
		PlaySound("Death")
	end

	HighlightService.new("Death",Person,DeathCounter_Duration)

	if CounterDisplay then
		CounterDisplay.Death.Visible = true

		DelayService.CountDown(`{Person.Name}-Death_Counter`,DeathCounter_Duration,1,function(elapsed)
			Person:SetAttribute("DeathCounter", elapsed)
		end,function()
			CounterDisplay.Death.Visible = false
			Person:SetAttribute("DeathCounter", nil)
			Person:RemoveTag("Counter-Cooldown")
		end)

	end

	Look_Behind(Root,DeathCounter_Duration)
end)

const function Is_Counter(r,Person,Root,CounterDisplay)
	if r.Name == "Counter" then 
		Events.Fire("Death Counter",Person,Root,CounterDisplay)
	elseif r.Name ~= "Counter" and not r.Name:find("Projectile") and not r.Name:find("Death") and r.Name:find("Counter") then
		Events.Fire("Counter",Person,Root,CounterDisplay)
	end
end

Events.Bind("CharacterAdded",function(Person : Model)
	const _,Hum,Root,Plr,Anim = Target(Person)

	task.wait(.2)

	if getgenv().Target_Name == Person.Name then
		Set_Target(Person)
	end

	ConnectionService.Connect("Died",Person,Hum.Died,nil,"Once",function()
		if getgenv().Target == Person then
			Set_Target(nil,Person.Name)
		end
		if Is_Owner and Person:GetAttribute("LastHit") == Player.Name then
			Emit(Owner_Assets.BF,Root)
		end
		ConnectionService.Disconnect({"Evasive","Ulted","ChildAdded"},Person)
		task.wait(Players.RespawnTime - .5)
		ConnectionService.Disconnect({"Damaged","FX_Added"},Person)
	end)

	const CounterDisplay = CounterUI:Clone()
	CounterDisplay.Parent = Root

	ConnectionService.Connect("Evasive",Person,Person:GetAttributeChangedSignal("JustEvasived"),nil,"Connect",function()
		if math.floor(Person:GetAttribute("JustEvasived")) == math.floor(tick()) then return end
		Person:SetAttribute("JustEvasived",tick())
	end)

	ConnectionService.Connect("Ulted",Person,Person:GetAttributeChangedSignal("Ulted"),nil,"Connect",function()
		DelayService.Yield(function() return not Person:FindFirstChildOfClass("ForceField") end,20)
		Person:SetAttribute("JustUltimate",tick())
	end)

	if Is_Owner then

		ConnectionService.Connect("Damaged",Person,Person:GetAttributeChangedSignal("LastDamage"),nil,"Connect",function()
			if Person:GetAttribute("LastHit") ~= Player.Name then return end
			task.wait()
			for _, fx in Person:QueryDescendants("ParticleEmitter") do
				fx.Color = Swap_Color(fx.Color,Owner_Color,Is_Blue)
			end
		end)

		ConnectionService.Connect("FX_Added",Person,Person.DescendantAdded,nil,"Connect",function(fx)
			Is_Counter(fx,Person,Root,CounterDisplay)

			if Person:GetAttribute("LastHit") ~= Player.Name then return end

			task.wait()

			if tick() - (Person:GetAttribute("LastDamage") + 3598) > 1.5 then return end

			if fx:IsA("ParticleEmitter") then
				fx.Color = Swap_Color(fx.Color,Owner_Color,Is_Blue)
			end

		end)
	else
		ConnectionService.Connect("ChildAdded",Person,Person.ChildAdded,nil,"Connect",function(counter)
			Is_Counter(counter,Person,Root,CounterDisplay)
		end)
	end
end)

Events.Bind("CharacterRemoving",function(Person)
	if getgenv().Target == Person then
		Set_Target(nil,Person.Name)
	end
end)

Events.Bind("PlayerRemoving",function(plr : Player)
	if getgenv().Target_Name == plr.Name then
		Set_Target(nil,plr.Name)
	end
end)

const function UnHide_TK(plr)
	const Leaderstats = plr:WaitForChild("leaderstats",Yield_TimeOut)

	local TotalKills = Leaderstats:FindFirstChild("Total Kills")

	if TotalKills then 
		return
	else
		TotalKills = Instance.new("NumberValue")
		TotalKills.Parent = Leaderstats
		TotalKills.Name = "Total Kills"
	end

	TotalKills.Value = plr:GetAttribute("TotalKillsFrb") or 0

	ConnectionService.Connect("Total Kills",plr,plr:GetAttributeChangedSignal("TotalKillsFrb"),nil,"Connect",function()
		TotalKills.Value = plr:GetAttribute("TotalKillsFrb")
	end)

	ConnectionService.Connect("LeaderstatRemoved",plr,Leaderstats.ChildRemoved,nil,"Connect",function()
		UnHide_TK(plr)
	end)
end

UnHide_TK(Player)

Events.Bind("PlayerAdded",UnHide_TK)

const Local_HP_Gui = UI.Health

getgenv().Off = function(Duration)
	Stare_Stop()
	DelayService.Cancel("On")

	DelayService.Delay("Off",Duration,function()
		SilentAim()
	end)
end

getgenv().On = function(Duration,Object,TurnOff)
	Stare_Connection(Object)

	DelayService.Cancel("Off")

	DelayService.Delay("On",Duration,function()
		if TurnOff then
			Stare_Stop()
			task.wait(TurnOff)
			SilentAim()
		else
			SilentAim()
		end
	end)
end

const CD_Tweens = {
	["Front Dash"] = TweenInfo.new(FrontDash_CD, Enum.EasingStyle.Linear, Enum.EasingDirection.In),
	["Side Dash"] = TweenInfo.new(SideDash_CD, Enum.EasingStyle.Linear, Enum.EasingDirection.In),
	["Evasive"] = TweenInfo.new(Evasive_CD, Enum.EasingStyle.Linear, Enum.EasingDirection.In)
}

function OnCD(Skill,CD)
	const Frame = UI.Cooldowns:FindFirstChild(Skill, true)

	if not Frame then
		return
	end

	const Fill = Frame.Fill
	const Value = Frame:FindFirstChildOfClass("TextLabel")

	Fill.Size = UDim2.fromScale(1, 1)
	TweenService:Create(Fill,CD_Tweens[Skill],{Size = UDim2.fromScale(0, 1)}):Play()

	DelayService.CountDown(Skill,CD,1,function(elapsed)
		Value.Text = `{Skill}: {tostring(elapsed)}`
	end,function()
		Value.Text = Skill
		TweenService:Create(Fill,TweenInfo.new(.2, Enum.EasingStyle.Linear, Enum.EasingDirection.In),{Size = UDim2.fromScale(0, 1)}):Play()
	end)
end

const function Dash_Comparable(Compare)
	if not Character:GetAttribute("JustForwardDashed") or workspace:GetAttribute("NoDashCooldown") then
		return true
	end
	return tick() - Character:GetAttribute("JustForwardDashed") > (Compare or FrontDash_CD)
end

const function MoveOnCD(Move)
	const Base = Current_Moveset[Move]

	if Base and Base.Parent then
		return Base:FindFirstChild("Cooldown") ~= nil
	end

	Current_Moveset[Move] = nil

	for _, Object in HotBar:GetChildren() do
		if not Object:IsA("GuiObject") then
			continue
		end

		const ObjectBase = Object:FindFirstChild("Base")

		if ObjectBase:FindFirstChild("ToolName").Text == Move then
			Current_Moveset[Move] = ObjectBase
			return ObjectBase:FindFirstChild("Cooldown") ~= nil
		end
	end

	return true
end

const function Custom_Ultimate()
	const MH = PlayerGui:WaitForChild("Bar").MagicHealth
	const Controller = MH.Health.Bar

	Controller.Bar.Image = Ult_Fill
	Controller.Parent.Glow.Image = Ult_Bar
	Controller.Parent.Glow.ImageTransparency = .1

	MH.Size = UDim2.fromOffset(397,25)
	Controller.Bar.Size = MH.Size
	Controller.Parent.Glow.Size = MH.Size

	TweenService:Create(Controller.Bar,ColorShift,{ImageColor3 = Is_Owner and Skins.All[Env.Picked_Skin].Color or Ult_Color}):Play()
end

const function Local_HP()
	const alpha = MathService.Alpha(Humanoid.Health,Humanoid.MaxHealth)

	TweenService:Create(Local_HP_Gui.Fill,Bar,{Size = UDim2.fromScale(alpha,1)}):Play()
	Local_HP_Gui:FindFirstChildOfClass("TextLabel").Text = `{tostring(math.round(alpha * 100))}%`

	if alpha <= 0 then
		Died_At = Hrp.Position
		if RNG:NextInteger(1,2) == 1 then
			PlaySound(Death_Sounds[RNG:NextInteger(1,#Death_Sounds)])
		end
		ConnectionService.Disconnect(nil,Character)

		Character = nil
		Humanoid = nil
		Hrp = nil
		Animator = nil
	end
end

const FrontDash_Attributes = {"JustForwardDashed","JustBackDashed"}
const SideDash_Attributes = {"JustRightDashed","JustLeftDashed"}

Events.Bind("MyCharacterAdded",function(New_Character)
	Character = New_Character

	task.spawn(function()
		const _, H, R, _, A = Target(New_Character)
		Humanoid = H
		Hrp = R
		Animator = A
		RE = Character:WaitForChild("Communicate",Yield_TimeOut)

		const Tech_VFX = TechDisplay:Clone()

		Tech_VFX.Parent = Character
		Tech_VFX.Adornee = Character:WaitForChild("Head",Yield_TimeOut)
	end)

	Character:SetAttribute("UltimateName",Script_Title)

	ConnectionService.Connect("Ult_Name",Character,Character:GetAttributeChangedSignal("UltimateName"),nil,"Connect",function() 
		if Character:GetAttribute("UltimateName") == Script_Title then return end
		Character:SetAttribute("UltimateName",Script_Title)
	end)

	if getgenv().SpawnNear and not Is_Ranked then
		task.wait(.2)

		local Closest
		local Distance = math.huge

		const Location = getgenv().SpawnNear == "Death" and Died_At or getgenv().SpawnNear == "Target" and select(3,Target())

		if Location then
			for _, Spawn in Map:GetChildren() do
				if Spawn.Name ~= "SpawnLocation" then continue end

				const SpawnDistance = MathService.GetDistance(Location,Spawn)

				if Distance > SpawnDistance then
					Closest = Spawn
					Distance = SpawnDistance
				end
			end

			if Closest then
				Hrp.CFrame = Closest.CFrame * CFrame.new(0,3,0)
			end
		end
	end

	task.wait(.1)

	table.clear(Character_Limbs)

	for _, b in Character:GetChildren() do
		if not b:IsA("BasePart") then continue end
		table.insert(Character_Limbs,b)
	end

	task.wait(.2)

	HotBar = PlayerGui:WaitForChild("Hotbar"):WaitForChild("Backpack"):WaitForChild("Hotbar")

	Custom_Ultimate()

	DelayService.Cancel_CountDown("Evasive",true)
	DelayService.Cancel_CountDown("FrontDash",true)
	DelayService.Cancel_CountDown("SideDash",true)

	SilentAim()

	ConnectionService.Connect("Animation",Character,Animator.AnimationPlayed,nil,"Connect",function(Track : AnimationTrack)

		const Condition = Anim_Lookup[Track.Animation.AnimationId]
		if not Condition then return end

		if not getgenv().Techs[Condition] then return end

		if Condition ~= "Third M1" then
			getgenv().Off(Track.Length)
		end

		if Condition == "Uptilt" and Character:GetAttribute("DragonUppercut") then
			return
		end

		const Nearest, Dist = Get_Nearest(Hrp)
		if not Nearest then return end

		if Dist > Attack_Distance then return end

		local _,Target_Humanoid,Target_Hrp,Target_Player,_ = Target(Nearest)

		if Target_Humanoid.Health <= (Condition == "Lethal" and 16 or 3.5) then return end

		local LastTech
		local LastPriority = -1

		for _, Tech in pairs(TechService.Enabled[Condition]) do
			if Tech.Priority <= LastPriority then continue end

			if Tech.RequiresPlayer and not Target_Player then continue end
			if Tech.UsesSkill and MoveOnCD(Tech.Skill) then continue end
			if Tech.UsesDash and not Dash_Comparable(5 - (Condition == "Lethal" and Track.Length - .2 or Track.Length * 2.5 / 3)) then continue end

			LastTech = Tech
			LastPriority = Tech.Priority
		end

		if not LastTech then return end

		if Condition == "Third M1" then
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then return end
			for Animation in Anti_Third do
				for _, Tech in pairs(TechService.Enabled[Animation]) do
					if Tech.Priority <= LastTech.Priority then continue end
					if Tech.RequiresPlayer and not Target_Player then continue end
					if Tech.UsesSkill and MoveOnCD(Tech.Skill) then continue end
					if Tech.UsesDash and not Dash_Comparable(5 - Track.Length * 2.5 / 3) then continue end

					return
				end
			end
		end

		if Anti_Third[Condition] then
			if Shiftlock_Enabled and getgenv().ShiftLock_Priority then return end

			Humanoid.AutoRotate = false

			Humanoid.WalkSpeed = 0
			Humanoid.JumpPower = 0

			ConnectionService.Connect("No_Movement",Character,Humanoid:GetPropertyChangedSignal("WalkSpeed"),.8,"Connect",function()
				Humanoid.WalkSpeed = 0
				Humanoid.JumpPower = 0
			end)
		end

		const Prediction_ = getgenv().Predicting

		getgenv().Predicting = false
		getgenv().InTech = true

		ConnectionService.Connect(`{Condition}-Tech`,Character,Track:GetMarkerReachedSignal(LastTech.Marker),Track.Length + .2,"Once",function()
			task.spawn(function()
				Tech_FX(LastTech.Name)
			end)

			if LastTech.DashBoost ~= 1 then
				Boost_moveme(LastTech.DashBoost)
			end

			const NoCollDur = LastTech.NoCollisionDuration or 3

			if LastTech.NoCollision then
				ConnectionService.Connect("No_Collision",Character,RunService.Heartbeat,NoCollDur,"Connect",function()
					for _, part in Character_Limbs do
						part.CanCollide = false
					end
				end)

				DelayService.Delay("Restore_Collision",NoCollDur,function()
					task.wait()
					for _, part in pairs(Limbs) do
						Character[part].CanCollide = true
					end
				end)
			end

			const yield = Condition == "Uptilt" and Uptilt_Swing

			if LastTech.Marker == "swingreg" and yield then
				task.wait(yield)
			end

			if LastTech.MarkerReached then
				LastTech.MarkerReached(Target_Hrp,Track)
			end

			Humanoid.WalkSpeed = 16
			Humanoid.JumpPower = 50

			Humanoid.AutoRotate = true

			getgenv().Predicting = Prediction_
			getgenv().InTech = false

			getgenv().Lerp = Lerp
			Override_StopDash = false
		end)

		Override_StopDash = LastTech.StopDash

		if LastTech.OnPlayed then
			getgenv().Off(Track.Length)
			LastTech.OnPlayed(Target_Hrp,Track)

			if not LastTech.MarkerReached then
				getgenv().Lerp = Lerp
				Override_StopDash = false
			end
		end

	end)

	ConnectionService.Connect("Ragdolled",Character,Character.ChildAdded,nil,"Connect",function(r)
		if r.Name == "Ragdoll" or r.Name == "RagdollSim" then
			Stare_Stop()
		end
	end)

	ConnectionService.Connect("UnRagdolled",Character,Character.ChildRemoved,nil,"Connect",function(r)
		if r.Name == "Ragdoll" or r.Name == "RagdollSim" then
			SilentAim()
		end
	end)

	Local_HP()

	ConnectionService.Connect("Health",Character,Humanoid.HealthChanged,nil,"Connect",function()
		Local_HP()
	end)

	ConnectionService.Connect("Died",Character,Humanoid.Died,nil,"Once",function()
		ConnectionService.Disconnect(nil,Character)

		Character = nil
		Humanoid = nil
		Hrp = nil
		Animator = nil
	end)

	ConnectionService.Connect("Evasived",Character,Character:GetAttributeChangedSignal("JustEvasived"),nil,"Connect",function()
		OnCD("Evasive",Evasive_CD)
	end)

	for _, Con in SideDash_Attributes do
		ConnectionService.Connect(Con,Character,Character:GetAttributeChangedSignal(Con),nil,"Connect",function()
			OnCD("Side Dash",SideDash_CD)

			if math.floor(Character:GetAttribute(Con)) == math.floor(tick()) then return end
			Character:SetAttribute(Con,tick())
		end)
	end

	for _, Con in FrontDash_Attributes do
		ConnectionService.Connect(Con,Character,Character:GetAttributeChangedSignal(Con),nil,"Connect",function()
			OnCD("Front Dash",FrontDash_CD)

			if math.floor(Character:GetAttribute(Con)) == math.floor(tick()) then return end
			Character:SetAttribute(Con,tick())
		end)
	end
end)

