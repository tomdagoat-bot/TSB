if not Is_Ranked then
	getgenv().ND = Extra:AddToggle({["Name"] = "Spawn Near Death",["CallBack"] = function(Value)
		if Value then
			getgenv().NT:Disable(false)
		end
		getgenv().SpawnNear = Value and "Death" or nil
	end,["Enabled"] = 	getgenv().SpawnNear == "Death",["Icon"] = "rbxassetid://9178976271"})

	getgenv().NT = Extra:AddToggle({["Name"] = "Spawn Near Target",["CallBack"] = function(Value)
		if Value then
			getgenv().ND:Disable(false)
		end
		getgenv().SpawnNear = Value and "Target" or nil
	end,["Enabled"] = 	getgenv().SpawnNear == "Target",["Icon"] = "rbxassetid://9178976271"})
end

if Is_Owner then
	Events.Bind("MyCharacterAdded",function(New_Character)
		const Skin = Skins.All[Env.Picked_Skin]
		
		Owner_Color = Skin.Color
		
		task.wait(.4)

		for _, Limb in New_Character:GetDescendants() do
			if Limb:IsA("Shirt") or Limb:IsA("Pants") or Limb:IsA("Accessory") or Limb:IsA("BodyColors") then
				Limb:Destroy()
			elseif table.find(Skin.Hidden_Limbs,Limb.Name) then
				Limb.Transparency = 1
				
				New_Character:AddTag(`No{Limb.Name}`)
			end
		end

		task.wait(.3)

		if Skin.Hide_Face then
			New_Character.Head.face:Destroy()
		end 

		const Cooldown_Preset = HotBar.Parent.LocalScript.Cooldown
		Cooldown_Preset.BackgroundColor3 = Hotbar_Color or Owner_Color
		Cooldown_Preset.BackgroundTransparency = .1

		if Skin.Cooldowns_Gradiant then
			Cooldown_Preset:FindFirstChildOfClass("UIGradient").Color = Skin.Cooldowns_Gradiant
		end

		for _, Accessory in Owner_Assets.Avatar:FindFirstChild(Env.Picked_Skin):GetChildren() do
			if Accessory:IsA("Accessory") then
				AddAccessory(Accessory)
			else
				Accessory:Clone().Parent = New_Character
			end
		end

		ConnectionService.Connect("Owner_FX",New_Character,New_Character.DescendantAdded,nil,"Connect",function(d)
			if (d:IsA("Trail") or d:IsA("ParticleEmitter")) then
				d.Color = Swap_Color(d.Color, Owner_Color, Is_Blue)
			end
		end)
	end)

	ConnectionService.Connect(
		"Hidden_VFX",
		game,
		workspace.Terrain.DescendantAdded,
		nil,
		"Connect",
		function(d)
			if not d:IsA("Trail") and not d:IsA("ParticleEmitter") then
				return
			end

			const Parent = d:FindFirstAncestorOfClass("Attachment") or d:FindFirstAncestorOfClass("BasePart")

			if not Parent then
				return
			end

			const Nearest = Get_Nearest(Parent,false)

			if not Nearest then
				return
			end

			if Nearest:GetAttribute("LastHit") ~= Player.Name then
				return
			end

			task.wait()

			if tick() - (Nearest:GetAttribute("LastDamage") + 3598) > 1.5 then return end

			d.Color = Swap_Color(d.Color, Owner_Color, Is_Blue)
		end
	)
end

Avatars:AddButton({["Name"] = "Headless", CallBack = function()
	const Head = Character:WaitForChild("Head",Yield_TimeOut)
	if not Head then return end

	Head.Transparency = Character:HasTag("NoHead") and 0 or 1
	Head.Size = Character:HasTag("NoHead") and Vector3.new(2,1,1) or Vector3.zero

	const Method = Character:HasTag("NoHead") and "RemoveTag" or "AddTag"

	Character[Method](Character,"NoHead")
end,})

