SilentAim_Section:AddButton({
	Name = "Select Target",
	CallBack = function()
		const Nearest = Get_Nearest()

		if not Nearest then
			Set_Target(nil)
			return 
		end

		if getgenv().Target == Nearest then
			Set_Target(nil,nil)
		else
			Set_Target(Nearest)
		end
	end,
	Icon = "rbxassetid://13285102351"
}):BindInput("Y")

const function Hitbox_Displayer()
	if (not getgenv().Target and getgenv().Predicting) or not getgenv().Predicting then
		ConnectionService.Disconnect("Server_Hitbox",game)
		Target_Hitbox.Parent = ReplicatedFirst
	elseif getgenv().Target and getgenv().Predicting then
		Target_Hitbox.Parent = workspace
		ConnectionService.Connect("Server_Hitbox",game,RunService.RenderStepped,nil,"Connect",function()
			if not getgenv().Target then
				ConnectionService.Disconnect("Server_Hitbox",game)
				Target_Hitbox.Parent = ReplicatedFirst
				return 
			end
			Target_Hitbox.CFrame = PredictCFrame(getgenv().Target:FindFirstChild("HumanoidRootPart"),getgenv().Prediction_After)
		end)
	end
end

Events.Bind("Locked_Changed",Hitbox_Displayer)

SilentAim_Section:AddToggle({
	Name = "Prediction",
	CallBack = function(Value)
		getgenv().Predicting = Value
		Hitbox_Displayer()
	end,
	Icon = "rbxassetid://6523858394",
	Enabled = getgenv().Predicting
}):BindInput("C")

