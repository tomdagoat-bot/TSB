const function Is_Blue(color)
	const h, s, v = color:ToHSV()
	return h >= 170/360 and h <= 260/360
		and s >= .15 and v >= .15
end

const function Swap_Color(CS : Color3, Color, IsColor)
	const KeyPoints = {}
	for _, KeyPoint in ipairs(CS.Keypoints) do
		const color = IsColor(KeyPoint.Value) and Color or KeyPoint.Value
		table.insert(KeyPoints, ColorSequenceKeypoint.new(KeyPoint.Time, color))
	end
	return ColorSequence.new(KeyPoints)
end

