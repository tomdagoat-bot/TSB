local Button_Sound = false

function TechService.new(info : typeof(Tech_Information))
	const Properties = table.clone(Tech_Information)

	for k, v in info do
		Properties[k] = v
	end

	if Properties["Priority"] < 0 then
		Properties["Priority"] = 0
	end

	const Section = AutoTechs.Content[`{Properties["Animation"]} Techs`]
	if not Section then return end

	const UI = Section:AddToggle({["Name"] = Properties.Name,["CallBack"] = function(Value)
		Properties.Enabled = Value
		TechService.Enabled[Properties.Animation][Properties.Name] = Properties.Enabled and Properties or nil

		if not Button_Sound then
			PlaySound("Button")
		end

		Button_Sound = true

		DelayService.Delay("Button_Sounds",.15,function()
			Button_Sound = false
		end)

		if not Properties["DisablesOthers"] or not Value then return end

		for _, Tech in pairs(TechService.Enabled[Properties.Animation]) do
			if Tech == Properties then continue end
			if Tech.Priority > Properties.Priority then continue end

			TechService.Enabled[Properties.Animation][Tech.Name] = nil

			Tech.UI:Disable(true)
		end
	end,["Icon"] = "rbxassetid://111935382692087",["Enabled"] = Properties.Enabled})
	UI:BindInput(Properties.Input) 

	if Properties.Enabled then
		TechService.Enabled[Properties.Animation][Properties.Name] = Properties
	end

	getgenv().Techs[Properties["Animation"]][Properties.Name] = Properties
	Properties["UI"] = UI
end

const function Stare_Stop()
	Humanoid.AutoRotate = true
	ConnectionService.Disconnect("Stare",Character)
end

const function PredictCFrame(Part, t)
	if typeof(Part) ~= "Instance" then
		return Part
	end
	const Pos = Part.Position + Part.AssemblyLinearVelocity * t
	return CFrame.new(Pos, Pos + Part.CFrame.LookVector)
end

const function Predict(TargetRoot)
	const Origin = Hrp.Position
	const TargetPosition = TargetRoot.Position

	const Offset = Origin - TargetPosition
	const Distance = Offset.Magnitude

	if Distance < 0.001 then
		return 0
	end

	const ToPlayer = Offset / Distance
	const Velocity = TargetRoot.AssemblyLinearVelocity

	const ClosingSpeed = Velocity:Dot(ToPlayer)

	local DistanceAlpha = math.clamp(
		(Distance - Prediction_Min_Distance) /
			(Prediction_Max_Distance - Prediction_Min_Distance),
		0,
		1
	)

	DistanceAlpha *= DistanceAlpha

	local Prediction = Prediction_After * DistanceAlpha

	if ClosingSpeed > 0 then
		const ClosingAlpha = math.min(
			ClosingSpeed / Prediction_Max_ClosingSpeed,
			1
		)

		const FacingDot = TargetRoot.CFrame.LookVector:Dot(ToPlayer)

		Prediction += .12 * ClosingAlpha

		Prediction += .08
			* ClosingAlpha
			* math.clamp((FacingDot - .1) / .9, 0, 1)

		const AngularSpeed = TargetRoot.AssemblyAngularVelocity.Magnitude

		Prediction -= .12
			* math.min(AngularSpeed / Prediction_Max_AngularVelocity, 1)
			* ClosingAlpha

		if not (
			ClosingSpeed >= Prediction_Backward_ClosingSpeed
				and Distance >= Prediction_Min_Backward_Distance
				and FacingDot >= Prediction_Backward_Dot
				and AngularSpeed <= Prediction_Max_AngularVelocity
			) then

			const TimeToPlayer = Distance / ClosingSpeed
			Prediction = math.min(
				Prediction,
				math.max(0, TimeToPlayer - .06)
			)
		end
	end

	return math.clamp(Prediction + .1, 0, Max_Predicition)
end

const function Stare_Connection(Object)
	if not getgenv().Target and not Object then warn("pls select a target") return end

	const H = getgenv().Target and getgenv().Target:FindFirstChild("Humanoid")

	if (not H or H.Health <= 0) and not Object then
		return
	end

	if not Character or not Humanoid or not Hrp or Humanoid.Health <= 0 then
		return
	end

	const Goal = Object or getgenv().Target:WaitForChild("HumanoidRootPart")
	const Is_Root = typeof(Goal) == "Instance"

	ConnectionService.Connect("Stare", Character, RunService.Heartbeat, nil, "Connect", function()
		if Shiftlock_Enabled and Env.ShiftLock_Priority then
			return
		end

		if not Humanoid or not Hrp or Humanoid.Health <= 0 then
			ConnectionService.Disconnect(nil,Character)
			return
		end

		Humanoid.AutoRotate = false

		const Predicting = Env.Predicting
		const PredictionDynamic = Env.Prediction_Dynamic

		if PredictionDynamic and Predicting and Is_Root then
			Env.Prediction_After = Predict(Goal)
		end

		const PredictionAfter = Env.Prediction_After

		const LookAt = Predicting
			and PredictCFrame(Goal, PredictionAfter)
			or Goal

		MathService.LookAt(Hrp, LookAt, Env.Lerp)
	end)
end

const function Boost_moveme(m)
	if not m or m == 1 then return end

	task.spawn(function()
		const moveme = Hrp:WaitForChild("moveme",Yield_TimeOut)
		if not moveme then return end

		while moveme and moveme.Parent ~= nil do
			moveme.Velocity *= m
			task.wait()
		end

	end)

end

const TargetUI = UI.Target
const TargetBars = TargetUI.Bars

function Set_Target(Model,Name)
	const OldTarget = getgenv().Target

	if OldTarget and OldTarget:FindFirstChild("Silent") then
		HighlightService.FadeOut(OldTarget:FindFirstChild("Silent"))
	end

	getgenv().Target = Model
	getgenv().Target_Name = Name

	if not Model then
		TweenService:Create(UI.Target,Appear,{Position = UI.Target:GetAttribute("Hidden")}):Play()
		TargetBars.Health.Fill.Size = UDim2.fromScale(1, 1)
		Stare_Stop()
		ConnectionService.Disconnect(nil,Target_Key)
	else
		TweenService:Create(UI.Target,Appear,{Position = UI.Target:GetAttribute("Position")}):Play()
		Update_TargetInfo()
		HighlightService.new("Silent",getgenv().Target)
		SilentAim()
	end

	PlaySound("Open")
	Events.Fire("Locked_Changed")
end

const Teleporter = TargetUI:FindFirstChild("Teleport")

const function GetProfile(Plr)
	if Plr then
		const Success, ImageID = pcall(function()
			return Players:GetUserThumbnailAsync(
				Plr.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size420x420
			)
		end)
		if Success then return ImageID end
	end
	return Default_Profile
end

const function Locked_Evasive(Target)
	if Target:GetAttribute("JustEvasived") then
		const endtime = Target:GetAttribute("JustEvasived") + Evasive_CD

		if endtime - tick() <= 0 then
			TargetBars.Ragdoll.Visible = false
		else
			TargetBars.Ragdoll.Visible = true

			local timeleft = endtime - tick()
			const alpha = MathService.Alpha(timeleft,Evasive_CD)

			DelayService.CountDown("Target-Evasive",timeleft,1,function(elapsed)
				TargetBars.Ragdoll.Value.Text = `Evasive: {tostring(math.floor(elapsed))}s`
			end,function()
				TargetBars.Ragdoll.Visible = false
			end)

			timeleft = math.max(0,timeleft - Bar.Time)

			if timeleft > 0 then
				TweenService:Create(TargetBars.Ragdoll.Fill,Bar,{Size = UDim2.fromScale(alpha,1)}):Play()
				task.wait(Bar.Time)
				TweenService:Create(TargetBars.Ragdoll.Fill,TweenInfo.new(timeleft,Enum.EasingStyle.Linear,Enum.EasingDirection.In),{Size = UDim2.fromScale(0,1)}):Play()
			else
				TargetBars.Ragdoll.Visible = false
			end
		end
	else
		TargetBars.Ragdoll.Visible = false
	end
end

const function Locked_Kills(TargetPlayer)
	const Kills = TargetPlayer:WaitForChild("leaderstats"):FindFirstChild("Kills")

	if Kills then
		TargetUI.Kills.Text = `Kills: {Kills.Value}`
		ConnectionService.Connect("Kills",Target_Key,Kills:GetPropertyChangedSignal("Value"),nil,"Connect",function()
			TargetUI.Kills.Text = `Kills: {Kills.Value}`
		end)
	else
		TargetUI.Kills.Text = "Kills: Hidden"
		ConnectionService.Disconnect("Kills",Target_Key)
	end
end

const function Locked_DC(Target)
	if Target:GetAttribute("DeathCounter") then
		TargetUI.Death.Visible = true
		DelayService.Delay("Locked_CounterDisplay",Target:GetAttribute("DeathCounter"),function()
			TargetUI.Death.Visible = false
		end)
	else
		TargetUI.Death.Visible = false
	end
end

