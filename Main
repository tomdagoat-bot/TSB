function Emit(VFX,Parent)
	if Parent then
		VFX = VFX:Clone()
		VFX.Parent = Parent
	end
	if VFX:IsA("ParticleEmitter") then
		if VFX:GetAttribute("EmitDelay") then
			task.delay(VFX:GetAttribute("EmitDelay"),function()
				VFX:Emit(VFX:GetAttribute("EmitCount") or 1)
			end)
		else
			VFX:Emit(VFX:GetAttribute("EmitCount") or 1)
		end
	else	
		for _, p in VFX:QueryDescendants("ParticleEmitter") do
			Emit(p)
		end
	end
end

